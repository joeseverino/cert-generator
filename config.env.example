# Certificate subject fields
ORG="Your Org"
OU="Homelab"
COUNTRY="US"

# SSH hostname or alias for the offline CA VM
# Must be reachable via SSH from this machine (add to ~/.ssh/config if needed)
CA_HOST="offline-ca"

# Paths to CA cert and key on the remote CA host
CA_CERT="~/ca.pem"
CA_KEY="~/ca.key"

# Certificate validity in days (825 = macOS/browser max)
CERT_DAYS=825

# RSA key size
KEY_BITS=4096

# Where signed certs are saved locally (a subfolder per hostname is created)
LOCAL_OUTPUT="${HOME}/certs"
